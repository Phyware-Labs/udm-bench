<?xml version="1.0" ?>
<!--
  udm-bench: TurtleBot3 default world
  minimal reproducible SDF world.

  A flat ground plane + a sun + four perimeter walls bounding an 8×8 m
  area, with two static obstacle boxes ("obstacle_box_1" and
  "obstacle_box_2") in known positions so the tb3_map_mismatch fault
  injector (faults/turtlebot3/map_mismatch.py) has a deterministic
  target to translate.
-->
<sdf version="1.7">
  <world name="turtlebot3_world">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <model name="wall_north">
      <static>true</static>
      <pose>0 4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8 0.1 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8 0.1 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>4 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 8 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 8 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-4 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 8 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 8 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="obstacle_box_1">
      <static>true</static>
      <pose>1.5 0.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="obstacle_box_2">
      <static>true</static>
      <pose>-2.0 1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
