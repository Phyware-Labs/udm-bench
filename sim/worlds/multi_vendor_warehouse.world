<?xml version="1.0" ?>
<!--
  udm-bench: multi_vendor_warehouse
  Identical warehouse layout to small_warehouse, with
  enough ceiling clearance (10 m) for a PX4 SITL quadcopter to operate
  overhead while the TurtleBot3 patrols the ground level.
-->
<sdf version="1.7">
  <world name="multi_vendor_warehouse">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Perimeter walls (12 m × 10 m × 10 m tall) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12 0.1 10</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12 0.1 10</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12 0.1 10</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12 0.1 10</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>6 0 5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 10 10</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 10 10</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 10 10</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 10 10</size></box></geometry></visual>
      </link>
    </model>

    <!-- Two parallel shelf rows on the ground level -->
    <model name="shelf_row_1">
      <static>true</static>
      <pose>0 1.5 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 0.4 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8 0.4 2</size></box></geometry></visual>
      </link>
    </model>
    <model name="shelf_row_2">
      <static>true</static>
      <pose>0 -1.5 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 0.4 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8 0.4 2</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
